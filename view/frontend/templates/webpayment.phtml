<?php
/** @var $block \Sapient\Worldpay\Block\Webpayment */

$param = $block->getRequest()->getParams();

$myAccountException = $block->getMyAccountSpecificException('MCAM8');
$ccException = $block->getCreditCardSpecificException('CCAM12');

if (array_key_exists('error', $param)) {
    if (array_key_exists('message', $param)) {
        $block->getMessageManager()->addError(__($ccException));
    } else {
        $block->getMessageManager()->addError(__($myAccountException));
    }
}

$displayItems = [];
foreach ($block->getAllItems() as $item) {
    $displayItems[] = [
        'label' => (string)$item->getData('name'),
        'amount' => [
            'currency' => (string)$block->getCurrency(),
            'value' => (string)$item->getData('price')
        ]
    ];
}

$config = [
    'storeCode' => (string)$block->getStoreCode(),
    'serviceWorkerUrl' => (string)$block->getServiceWorkerUrl(),
    'serviceWorkerScope' => rtrim((string)$block->getServiceWorkerScope(), '/') . '/',
    'chromepayButtonName' => (string)$block->getChromepayButtonName(),
    'chromepayEnabled' => (bool)$block->getChromepayEnabled(),
    'chromePaymentMode' => (string)$block->getPaymentMode(),
    'subscriptionStatus' => (bool)$block->checkSubscriptionItems(),
    'generalExceptions' => (string)$block->getGeneralException(),
    'myAccountExceptions' => (string)$block->MyAccountExceptions(),
    'creditCardException' => (string)$block->getCreditCardException(),
    'isDynamic3DS2Enabled' => (bool)$block->isDynamic3DS2Enabled(),
    'is3DsEnabled' => (bool)$block->is3DsEnabled(),
    'jwtEventUrl' => (string)$block->getJwtEventUrl(),
    'isCheckoutCartPage' => (bool)$block->isCheckoutCartPage(),
    'envMode' => (string)$block->getEnvMode(),
    'baseUrl' => (string)$block->getBaseUrl(),
    'currency' => (string)$block->getCurrency(),
    'reqShipping' => (bool)$block->getShippingRequired(),
    'isDownloadable' => (bool)$block->checkDownloadableProduct(),
    'subtotal' => (string)$block->getSubTotal(),
    'shippingRate' => (string)$block->getShippingRate(),
    'taxRate' => (string)$block->getTaxRate(),
    'discountRate' => (string)$block->getDiscountRate(),
    'total' => (string)$block->getTotal(),
    'productCount' => (int)$block->getProductCount(),
    'sessionId' => (string)$block->getSessionId(),
    'displayItems' => $displayItems
];

/** @var \Magento\Framework\View\Element\Template $block */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$secureRenderer = $objectManager->get(\Magento\Framework\View\Helper\SecureHtmlRenderer::class);

$jsonConfig = json_encode([
    "#worldpay-chromepay-init" => [
        "Sapient_Worldpay/js/view/payment/chromepay" => $config
    ]
], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);

?>
<div id="worldpay-chromepay-init"></div>

<?= /* @noEscape */ $secureRenderer->renderTag('script', ['type' => 'text/x-magento-init'], $jsonConfig, false); ?>
