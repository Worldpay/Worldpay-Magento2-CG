{
   "name":"sapient/module-worldpay",
   "description":"Sapient WorldPay Payment Module",
   "type":"magento2-module",
   "require":{
      "magento/module-sales": ">=100.0.0",
      "magento/module-payment": ">=100.0.0",
      "magento/module-quote": ">=100.0.0",
      "magento/module-vault": ">=100.0.0"
   },
   "version": "2.4.9-alpha0626",
   "license":"proprietary",
   "autoload":{
      "files":[
         "registration.php"
      ],
      "psr-4":{
         "Sapient\\Worldpay\\":""
      }
   },
   "require-dev": {
      "magento/magento-coding-standard": "^41",
      "phpstan/phpstan": "^2.1",
      "bitexpert/phpstan-magento": "^0.44",
      "phpstan/extension-installer": "^1.4"
   },
   "config": {
      "allow-plugins": {
         "dealerdirect/phpcodesniffer-composer-installer": true,
         "phpstan/extension-installer": true
      }
   }
}
